#!/bin/sh /etc/rc.common
START=94
STOP=11
USE_PROCD=1
start_service() {
 mkdir -p /tmp/dae-manager
 chmod 700 /tmp/dae-manager
 procd_open_instance
 procd_set_param command /usr/local/bin/dae-manager --state /etc/dae-manager serve
 procd_set_param respawn 3600 5 5
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_set_param limits nofile="4096 4096"
 procd_close_instance
}
