#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
start_service() {
 [ -f /etc/dae-manager/current/config.dae ] || return 1
 mkdir -p /tmp/dae-manager
 chmod 700 /tmp/dae-manager
 /usr/local/bin/dae validate -c /etc/dae-manager/current/config.dae || return 1
 procd_open_instance
 procd_set_param command /usr/local/bin/dae run --disable-sudo --disable-pidfile -c /etc/dae-manager/current/config.dae --logfile /tmp/dae-manager/dae.log --logfile-maxsize 5 --logfile-maxbackups 2
 procd_set_param respawn 3600 5 5
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_set_param limits memlock="unlimited unlimited" nofile="65535 65535"
 procd_close_instance
}
